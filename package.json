const chatForm = document.getElementById('chatForm');
const chatPanel = document.getElementById('chatPanel');
const messageInput = document.getElementById('messageInput');
const clearBtn = document.getElementById('clearBtn');
const modeSelect = document.getElementById('modeSelect');
const toolLogList = document.getElementById('toolLogList');
const toolLogPanel = document.getElementById('toolLogPanel');
const insightBody = document.getElementById('insightBody');
const planList = document.getElementById('planList');

const sessionKey = 'ai-terminal-session-id';
const sessionId = localStorage.getItem(sessionKey) || crypto.randomUUID();
localStorage.setItem(sessionKey, sessionId);

function renderToolLog(logEntries = []) {
  if (!toolLogList) return;

  toolLogList.innerHTML = '';

  if (!logEntries.length) {
    if (toolLogPanel) toolLogPanel.hidden = true;
    return;
  }

  if (toolLogPanel) toolLogPanel.hidden = false;
  logEntries.forEach((entry) => {
    const item = document.createElement('li');
    const status = entry.status || 'ok';
    item.className = `tool-log-item ${status === 'pending' ? 'warning' : status === 'error' ? 'error' : 'success'}`;
    item.textContent = `${entry.step || 'action'} • ${status}`;
    item.title = entry.detail || '';
    toolLogList.appendChild(item);
  });
}

function renderPlan(plan = null) {
  if (!planList) return;
  planList.innerHTML = '';

  if (!plan || !plan.phases || !plan.phases.length) {
    const item = document.createElement('li');
    item.textContent = 'No active plan.';
    planList.appendChild(item);
    return;
  }

  plan.phases.forEach((phase) => {
    const item = document.createElement('li');
    item.textContent = phase;
    planList.appendChild(item);
  });
}

function renderInsight(memory = {}) {
  if (!insightBody) return;

  if (!memory || !memory.architecture) {
    insightBody.textContent = 'Ready.';
    return;
  }

  const architecture = memory.architecture;
  const jsNames = architecture.types?.js?.slice(0, 6).join(', ') || 'none';
  const htmlNames = architecture.types?.html?.slice(0, 6).join(', ') || '';
  const cssNames = architecture.types?.css?.slice(0, 6).join(', ') || '';

  insightBody.textContent = `${architecture.summary}\n\nFiles: ${jsNames}${htmlNames ? `\nHTML: ${htmlNames}` : ''}${cssNames ? `\nCSS: ${cssNames}` : ''}`;
}

function addMessage(role, text) {
  const wrapper = document.createElement('div');
  wrapper.className = `message ${role}`;

  const label = document.createElement('strong');
  label.textContent = role === 'user' ? 'You' : 'Assistant';

  const textNode = document.createElement('p');
  textNode.textContent = text;

  wrapper.appendChild(label);
  wrapper.appendChild(textNode);
  chatPanel.appendChild(wrapper);
  chatPanel.scrollTop = chatPanel.scrollHeight;
}

async function sendMessage(event) {
  event.preventDefault();

  const text = messageInput.value.trim();
  if (!text) return;

  const selectedMode = modeSelect.value;
  addMessage('user', text);
  messageInput.value = '';

  const placeholder = document.createElement('div');
  placeholder.className = 'message bot';
  placeholder.innerHTML = '<strong>Assistant</strong><p>Thinking...</p>';
  chatPanel.appendChild(placeholder);

  try {
    const response = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, sessionId, mode: selectedMode }),
    });

    const data = await response.json();
    placeholder.remove();

    if (!response.ok) {
      addMessage('bot', data.error || 'Something went wrong.');
      return;
    }

    renderToolLog(data.toolLog || []);
    renderPlan(data.plan || null);
    if (data.memory) renderInsight(data.memory);
    addMessage('bot', data.reply || 'No response returned.');
  } catch (error) {
    placeholder.remove();
    addMessage('bot', 'Unable to reach the AI service right now.');
  }
}

clearBtn.addEventListener('click', () => {
  chatPanel.innerHTML = `
    <div class="message bot">
      <strong>Assistant</strong>
      <p>Conversation cleared. Ask me anything.</p>
    </div>
  `;
  localStorage.setItem(sessionKey, crypto.randomUUID());
  renderToolLog([]);
  renderPlan(null);
  renderInsight({});
});

chatForm.addEventListener('submit', sendMessage);

if (chatPanel) {
  chatPanel.scrollTop = chatPanel.scrollHeight;
}

renderToolLog([]);
renderPlan(null);
renderInsight({});

